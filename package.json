{
  "name": "dsh-super-kb",
  "version": "1.7.0",
  "license": "MIT",
  "type": "module",
  "description": "DSH-Super-KB for DeepSeek Harness: browse/search local folders, WebDAV clouds, and self-hosted kb-server sources; preview images/SVG/PDF/audio/video/Office/CSV/Canvas; agent tools kb_search/kb_read/kb_list/kb_write/kb_publish; per-folder write switches via kb-server v3.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "knowledge-base",
    "webdav",
    "selfhost",
    "bm25",
    "rag",
    "agent-tools"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icons.js",
    "icons/*.png",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@xmldom/xmldom": "0.8.6",
    "jszip": "^3.10.2",
    "xlsx": "^0.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
